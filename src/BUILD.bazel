load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

RUNTIME_COPTS = [
    "-fno-exceptions",
    "-fno-rtti",
]

cc_library(
    name = "capability",
    srcs = ["capability.cc"],
    hdrs = ["capability.h"],
    copts = RUNTIME_COPTS,
    include_prefix = "cujpegxl",
)

cuda_library(
    name = "capability_cuda",
    srcs = ["capability_cuda.cu"],
    copts = RUNTIME_COPTS,
    deps = [":capability"],
)

cuda_library(
    name = "xyb",
    srcs = ["xyb.cu"],
    hdrs = ["xyb.h"],
    copts = RUNTIME_COPTS,
)

cuda_library(
    name = "dct",
    srcs = ["dct.cu"],
    hdrs = ["dct.h"],
    copts = RUNTIME_COPTS,
)

cuda_library(
    name = "nv12_to_xyb_dump_lib",
    testonly = True,
    srcs = ["nv12_to_xyb_dump.cu"],
    deps = [":xyb"],
)

cc_binary(
    name = "nv12_to_xyb_dump",
    testonly = True,
    srcs = ["nv12_to_xyb_dump_main.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [":nv12_to_xyb_dump_lib"],
)

cuda_library(
    name = "dct_dump_lib",
    testonly = True,
    srcs = ["dct_dump.cu"],
    deps = [":dct"],
)

cc_binary(
    name = "dct_dump",
    testonly = True,
    srcs = ["dct_dump_main.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [":dct_dump_lib"],
)

cuda_library(
    name = "quant",
    srcs = ["quant.cu"],
    hdrs = [
        "quant.h",
        "quant_weights_dct8.h",
    ],
    copts = RUNTIME_COPTS,
)

cuda_library(
    name = "quant_dump_lib",
    testonly = True,
    srcs = ["quant_dump.cu"],
    deps = [
        ":dct",
        ":quant",
    ],
)

cc_binary(
    name = "quant_dump",
    testonly = True,
    srcs = ["quant_dump_main.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [":quant_dump_lib"],
)

cuda_library(
    name = "entropy",
    srcs = ["entropy.cu"],
    hdrs = ["entropy.h"],
    copts = RUNTIME_COPTS,
)

cuda_library(
    name = "entropy_roundtrip",
    testonly = True,
    srcs = ["entropy_roundtrip.cu"],
    hdrs = ["entropy_roundtrip.h"],
    deps = [":entropy"],
)

cc_test(
    name = "entropy_gpu_test",
    srcs = ["entropy_gpu_test.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":entropy_roundtrip",
        "//tools/bitstream:vardct_frame",
        "@googletest//:gtest_main",
    ],
)

cuda_library(
    name = "frame_encoder",
    srcs = ["frame_encoder.cu"],
    hdrs = ["frame_encoder.h"],
    copts = RUNTIME_COPTS,
    deps = [
        ":entropy",
        "//src/bitstream",
        "//src/bitstream:frame_assembly",
    ],
)

cc_test(
    name = "frame_encoder_gpu_test",
    srcs = ["frame_encoder_gpu_test.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":frame_encoder",
        "//src/bitstream",
        "//tools/bitstream:vardct_frame",
        "@libjxl//:jxl",
        "@googletest//:gtest_main",
    ],
)

cuda_library(
    name = "dc_entropy_roundtrip",
    testonly = True,
    srcs = ["dc_entropy_roundtrip.cu"],
    hdrs = ["dc_entropy_roundtrip.h"],
    deps = [
        ":entropy",
        "//tools/bitstream:vardct_frame",
    ],
)

cc_test(
    name = "dc_entropy_gpu_test",
    srcs = ["dc_entropy_gpu_test.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":dc_entropy_roundtrip",
        "//tools/bitstream:vardct_frame",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "cujpegxl_lib",
    srcs = ["cujpegxl.cc"],
    copts = RUNTIME_COPTS,
    alwayslink = True,
    deps = [
        ":capability",
        ":capability_cuda",
        "//:cujpegxl_headers",
    ],
)

cc_test(
    name = "capability_test",
    srcs = ["capability_test.cc"],
    deps = [
        ":capability",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "query_backend_gpu_test",
    srcs = ["query_backend_gpu_test.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":capability",
        ":capability_cuda",
        ":cujpegxl_lib",
        "//:cujpegxl_headers",
        "@googletest//:gtest_main",
    ],
)
