load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

RUNTIME_COPTS = [
    "-O3",
    "-fno-exceptions",
    "-fno-rtti",
]

cc_library(
    name = "capability",
    srcs = ["capability.cc"],
    hdrs = ["capability.h"],
    copts = RUNTIME_COPTS,
    include_prefix = "cujpegxl",
)

cuda_library(
    name = "capability_cuda",
    srcs = ["capability_cuda.cu"],
    copts = RUNTIME_COPTS,
    deps = [":capability"],
)

cc_library(
    name = "xyb_impl",
    hdrs = ["xyb_impl.cuh"],
)

# Standalone stage kernel retained as the libjxl-oracle conformance harness over
# the shared opsin transform (xyb_impl.cuh); the production path is the fused
# front-end.
cuda_library(
    name = "xyb",
    testonly = True,
    srcs = ["xyb.cu"],
    hdrs = ["xyb.h"],
    copts = RUNTIME_COPTS,
    deps = [":xyb_impl"],
)

cc_library(
    name = "dct_impl",
    hdrs = ["dct_impl.cuh"],
)

cc_library(
    name = "exact_div",
    hdrs = ["exact_div.cuh"],
)

cc_library(
    name = "warp_scan",
    hdrs = ["warp_scan.cuh"],
)

cc_library(
