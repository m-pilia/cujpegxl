load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

RUNTIME_COPTS = [
    "-O3",
    "-fno-exceptions",
    "-fno-rtti",
]

cc_library(
    name = "capability",
    srcs = ["capability.cc"],
    hdrs = ["capability.h"],
    copts = RUNTIME_COPTS,
    include_prefix = "cujpegxl",
)

cuda_library(
    name = "capability_cuda",
    srcs = ["capability_cuda.cu"],
    copts = RUNTIME_COPTS,
    deps = [":capability"],
)

cc_library(
    name = "xyb_impl",
    hdrs = ["xyb_impl.cuh"],
)

# Standalone stage kernel retained as a conformance-test harness over the shared
# opsin transform (xyb_impl.cuh); the production path is the fused front-end.
cuda_library(
    name = "xyb",
    testonly = True,
    srcs = ["xyb.cu"],
    hdrs = ["xyb.h"],
    copts = RUNTIME_COPTS,
    deps = [":xyb_impl"],
)

cuda_library(
    name = "dct",
    testonly = True,
    srcs = ["dct.cu"],
    hdrs = ["dct.h"],
    copts = RUNTIME_COPTS,
)

cc_library(
    name = "coeff_order",
    srcs = ["coeff_order.cc"],
    hdrs = ["coeff_order.h"],
    copts = RUNTIME_COPTS,
)

cc_library(
    name = "vardct_layout",
    srcs = ["vardct_layout.cc"],
    hdrs = ["vardct_layout.h"],
    copts = RUNTIME_COPTS,
)

cc_binary(
    name = "vardct_layout_dump",
    testonly = True,
    srcs = ["vardct_layout_dump.cc"],
    deps = [":vardct_layout"],
)

cc_test(
    name = "vardct_layout_test",
    srcs = ["vardct_layout_test.cc"],
    deps = [
        ":vardct_layout",
        "@googletest//:gtest_main",
    ],
)

cuda_library(
    name = "transform_select",
    srcs = ["transform_select.cu"],
    hdrs = [
        "transform_select.h",
        "transform_select_impl.cuh",
    ],
    copts = RUNTIME_COPTS,
    deps = [
        ":quant_consts",
        ":vardct_layout",
    ],
)

cc_test(
    name = "transform_select_gpu_test",
    srcs = ["transform_select_gpu_test.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":transform_select",
        ":vardct_layout",
        "@googletest//:gtest_main",
    ],
)

cuda_library(
    name = "frontend_transform",
    # testonly until wired into the runtime (T6 step 5); it composes the
    # standalone (testonly) nv12_to_xyb kernel of the correctness-first path.
    testonly = True,
    srcs = ["frontend_transform.cu"],
    hdrs = ["frontend_transform.h"],
    copts = RUNTIME_COPTS,
    deps = [
        ":transform_select",
        ":vardct_layout",
        ":xyb",
    ],
)

cc_test(
    name = "frontend_transform_gpu_test",
    srcs = ["frontend_transform_gpu_test.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":frontend_transform",
        ":transform_select",
        ":vardct_layout",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "cfl",
    hdrs = ["cfl.h"],
    copts = RUNTIME_COPTS,
)

cuda_library(
    name = "cfl_cuda",
    srcs = ["cfl.cu"],
