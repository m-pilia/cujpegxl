cc_test(
    name = "container_test",
    srcs = ["container_test.cc"],
    deps = [
        ":bitstream",
        "//tools/bitstream:vardct_frame",
        "@libjxl//lib:jpegxl",
        "@libjxl//lib:jpegxl_private",
