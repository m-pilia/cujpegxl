load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

RUNTIME_COPTS = [
    "-O3",
    "-fno-exceptions",
    "-fno-rtti",
]

cc_library(
    name = "bitstream",
    srcs = [
        "ans_encoder.cc",
        "ans_histogram.cc",
        "codestream.cc",
        "container.cc",
        "context_map.cc",
        "histogram_writer.cc",
        "prefix_code.cc",
    ],
    hdrs = [
        "ans_encoder.h",
        "ans_histogram.h",
        "bit_writer.h",
        "codestream.h",
        "container.h",
        "context_map.h",
        "field_coder.h",
        "histogram_writer.h",
        "hybrid_uint.h",
        "prefix_code.h",
    ],
    copts = RUNTIME_COPTS,
)

cc_test(
    name = "ans_encoder_test",
    srcs = ["ans_encoder_test.cc"],
    deps = [
        ":bitstream",
        "@libjxl//:jxl",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "ans_histogram_test",
    srcs = ["ans_histogram_test.cc"],
    deps = [
        ":bitstream",
        "@libjxl//:jxl",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "context_map_test",
    srcs = ["context_map_test.cc"],
    deps = [
        ":bitstream",
        "@libjxl//:jxl",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "frame_assembly",
    srcs = ["frame_assembly.cc"],
    hdrs = ["frame_assembly.h"],
    copts = RUNTIME_COPTS,
    deps = [
        ":bitstream",
        "//src:ac_context",
        "//src:dc_predict",
    ],
)

cc_test(
    name = "frame_assembly_test",
    srcs = ["frame_assembly_test.cc"],
    deps = [
        ":frame_assembly",
        "//tools/bitstream:vardct_frame",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "codestream_parse_test",
    srcs = ["codestream_parse_test.cc"],
    deps = [
        ":bitstream",
        "@libjxl//:jxl",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "clustered_histogram_test",
    srcs = ["clustered_histogram_test.cc"],
    deps = [
        ":bitstream",
        "@libjxl//:jxl",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "container_test",
    srcs = ["container_test.cc"],
    deps = [
        ":bitstream",
        "//tools/bitstream:vardct_frame",
        "@libjxl//:jxl",
        "@googletest//:gtest_main",
    ],
)
