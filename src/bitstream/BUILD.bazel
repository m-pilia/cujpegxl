load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

RUNTIME_COPTS = [
    "-O3",
    "-fno-exceptions",
    "-fno-rtti",
]

cc_library(
    name = "bitstream",
    srcs = [
        "ans.cc",
        "codestream.cc",
        "container.cc",
        "context_map.cc",
        "histogram_writer.cc",
        "prefix_code.cc",
        "token_stream.cc",
    ],
    hdrs = [
        "ans.h",
        "bit_sink.h",
        "bit_writer.h",
        "codestream.h",
        "container.h",
        "context_map.h",
        "field_coder.h",
        "frame_assembly.h",
        "histogram_writer.h",
        "hybrid_uint.h",
        "prefix_code.h",
        "serialize_impl.h",
        "token_stream.h",
    ],
    copts = RUNTIME_COPTS,
    deps = [
        "//src:ac_context",
        "//src:dc_predict",
    ],
)

cc_library(
    name = "token_stream_reference",
    testonly = True,
    srcs = ["token_stream_reference.cc"],
    hdrs = ["token_stream_reference.h"],
    deps = [":bitstream"],
)

cc_test(
    name = "ans_test",
    srcs = ["ans_test.cc"],
    deps = [
        ":bitstream",
        "@googletest//:gtest_main",
        "@libjxl//lib:jpegxl",
        "@libjxl//lib:jpegxl_private",
    ],
)

cc_test(
    name = "token_stream_test",
    srcs = ["token_stream_test.cc"],
    deps = [
        ":bitstream",
        ":frame_assembly",
        ":token_stream_reference",
        "//src:ac_context",
        "@googletest//:gtest_main",
        "@libjxl//lib:jpegxl",
        "@libjxl//lib:jpegxl_private",
    ],
)

cc_test(
    name = "context_map_test",
    srcs = ["context_map_test.cc"],
    deps = [
        ":bitstream",
        "@libjxl//lib:jpegxl",
        "@libjxl//lib:jpegxl_private",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "frame_assembly",
    srcs = ["frame_assembly.cc"],
    hdrs = ["frame_assembly.h"],
    copts = RUNTIME_COPTS,
    deps = [
        ":bitstream",
        "//src:ac_context",
        "//src:dc_predict",
        "//src:vardct_layout",
    ],
)

cc_library(
    name = "prefix_build_reference",
    testonly = True,
    srcs = ["prefix_build_reference.cc"],
    hdrs = ["prefix_build_reference.h"],
    deps = [
        ":bitstream",
        ":frame_assembly",
        "//src:vardct_layout",
    ],
)

cc_test(
    name = "frame_assembly_test",
    srcs = ["frame_assembly_test.cc"],
    deps = [
        ":frame_assembly",
        ":prefix_build_reference",
        "//tools/bitstream:vardct_frame",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "codestream_parse_test",
    srcs = ["codestream_parse_test.cc"],
    deps = [
        ":bitstream",
        "@libjxl//lib:jpegxl",
        "@libjxl//lib:jpegxl_private",
