+def _cuda_toolkit_alias_impl(ctx):
+    lines = [
+        'load("@bazel_skylib//rules:common_settings.bzl", "bool_setting")',
+        'package(default_visibility = ["//visibility:public"])',
+        'bool_setting(name = "valid_toolchain_found", build_setting_default = True)',
+    ]
+    targets = ["cuda_all_files", "cuda_headers", "cuda_license"]
+    for component in ctx.attr.components:
+        targets.extend(component_targets(component, ctx.attr.version))
+    for target in targets:
+        choices = {condition: repo + "//:" + target for condition, repo in ctx.attr.target_toolkits.items()}
+        lines.append("alias(name = %r, actual = select(%r))" % (target, choices))
+    ctx.file("BUILD.bazel", "\n".join(lines), executable = False)
+    major, minor = ctx.attr.version.split(".")[:2]
+    template_helper.generate_defs_bzl(ctx, major, minor, False)
+    for package, name in [
+        ("toolchain", "nvcc-local-toolchain"),
+        ("toolchain/clang", "clang-local-toolchain"),
+        ("toolchain/disabled", "disabled-local-toolchain"),
+    ]:
+        ctx.file(package + "/BUILD.bazel", 'alias(name = %r, actual = %r, visibility = ["//visibility:public"])' % (
+            name,
+            ctx.attr.default_toolkit + "//" + package + ":" + name,
+        ), executable = False)
+
+cuda_toolkit_alias = repository_rule(
