load("@cujpegxl_pip//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

cc_binary(
    name = "encode_to_file",
    srcs = ["encode_to_file.cc"],
    tags = ["gpu"],
    visibility = ["//visibility:public"],
    deps = [
        "//src:frame_encoder",
        "//src:worker_pool",
    ],
)

py_library(
    name = "golden_hash_lib",
    srcs = ["golden_hash.py"],
    imports = [
        ".",
        "../corpus",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/corpus:corpus_prep_lib",
        requirement("numpy"),
        requirement("pillow"),
    ],
)

py_binary(
    name = "golden_hash",
    srcs = ["golden_hash.py"],
    data = [
        ":encode_to_file",
        "//data:frames",
    ],
    imports = [
        ".",
        "../corpus",
    ],
    deps = [":golden_hash_lib"],
)

py_test(
    name = "golden_hash_test",
    srcs = ["golden_hash_test.py"],
    deps = [":golden_hash_lib"],
)
