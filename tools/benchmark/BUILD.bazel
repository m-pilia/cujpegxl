load("@cujpegxl_pip//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//toolchains/tests:jetson_binary.bzl", "jetson_binary")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "gjxl_benchmark_enabled",
    define_values = {"gjxl_benchmark": "true"},
)

cc_library(
    name = "benchmark_stats",
    srcs = ["benchmark_stats.cc"],
    hdrs = ["benchmark_stats.h"],
)

cc_library(
    name = "rgb_bench_driver",
    srcs = ["rgb_bench_driver.cc"],
    hdrs = ["rgb_bench_driver.h"],
    deps = [":benchmark_stats"],
)

cc_library(
    name = "nvjpeg_encoder",
    srcs = ["nvjpeg_encoder.cc"],
    hdrs = ["nvjpeg_encoder.h"],
    deps = [
        "@cuda//:cuda_runtime_static",
    ] + select({
        "//platforms:is_jetson": ["@cuda//:nvjpeg_static"],
        "//conditions:default": ["@cuda//:nvjpeg"],
    }),
)

cc_binary(
    name = "encode_bench",
    srcs = ["encode_bench.cc"],
    tags = ["gpu"],
    deps = [
        ":benchmark_stats",
        ":nvjpeg_encoder",
        "//src:frame_encoder",
        "//src:worker_pool",
    ] + select({
        "//platforms:is_jetson": ["@cuda//:nvtx_headers"],
        "//conditions:default": ["@cuda//:nvtx3"],
    }),
)

jetson_binary(
    name = "jetson_encode_bench",
    testonly = True,
    binary = ":encode_bench",
)

py_test(
    name = "jetson_linkage_test",
    size = "small",
    srcs = ["jetson_linkage_test.py"],
    tags = ["no-sanitizers"],
    args = [
        "$(rootpath :jetson_encode_bench)",
        "$(rootpath @llvm_toolchain_llvm//:bin/llvm-readelf)",
    ],
    data = [
        ":jetson_encode_bench",
        "@llvm_toolchain_llvm//:bin/llvm-readelf",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "rgb_bench",
    srcs = ["libjxl_bench.cc"],
    deps = [
        ":rgb_bench_driver",
        "@libjxl//lib:jpegxl",
        "@libjxl//lib:jpegxl_threads",
    ],
)

# NOTE: non-hermetic build for gjxl due to dependency on the GCC toolchain.
genrule(
    name = "gjxl_shared_library",
    srcs = [
        "@gjxl//:CMakeLists.txt",
        "@gjxl//:sources",
    ],
    outs = ["libgjxl_benchmark.so"],
    cmd = "$(location :build_gjxl.sh) $(location @gjxl//:CMakeLists.txt) $(location :libgjxl_benchmark.so) 61",
    tags = ["manual"],
    tools = ["build_gjxl.sh"],
)

cc_import(
    name = "gjxl_import",
    shared_library = ":libgjxl_benchmark.so",
    tags = ["manual"],
)

cc_binary(
    name = "gjxl_bench",
    srcs = ["gjxl_bench.cc"],
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":gjxl_import",
        ":rgb_bench_driver",
        "@gjxl//:c_api_headers",
    ],
)

py_library(
    name = "benchmark_lib",
    srcs = ["benchmark.py"],
    imports = [
        ".",
        "../corpus",
    ],
    deps = [
        "//tools/corpus:corpus_prep_lib",
        requirement("numpy"),
        requirement("pillow"),
    ],
)

py_binary(
    name = "benchmark",
    srcs = ["benchmark.py"],
    data = [
        ":encode_bench",
        ":rgb_bench",
        "//data:frames",
    ] + select({
        ":gjxl_benchmark_enabled": [":gjxl_bench"],
        "//conditions:default": [],
    }),
    imports = [
        ".",
        "../corpus",
    ],
    deps = [":benchmark_lib"],
)

py_binary(
    name = "comparison",
    srcs = ["comparison.py"],
    data = [
        ":encode_bench",
        "//data:frames",
    ],
    imports = [
        ".",
        "../corpus",
    ],
    deps = [":benchmark_lib"],
)
