common --enable_bzlmod

build --incompatible_enable_cc_toolchain_resolution
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

build --copt=-O3
build --host_copt=-O3

build --@rules_cuda//cuda:compiler=clang
build --@rules_cuda//cuda:archs=sm_61;sm_87

# Drive CUDA device compilation with the registered hermetic clang cc toolchain
# rather than whatever clang is on PATH, so the PTX ISA version stays matched to
# the hermetic ptxas.
common --repo_env=CUDA_COMPILER_USE_CC_TOOLCHAIN=true

# Statically link the CUDA runtime so consumers can link it without a CUDA toolkit.
build --@rules_cuda//cuda:runtime=@cuda//:cuda_runtime_static

test --test_output=errors

build:asan --features=asan
build:asan --copt=-O1
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-g
build:asan --strip=never
build:asan --test_env=ASAN_OPTIONS=halt_on_error=1:detect_leaks=1
test:asan --test_tag_filters=-no-sanitizers

build:ubsan --features=ubsan
build:ubsan --copt=-fno-sanitize-recover=all
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --copt=-g
build:ubsan --strip=never
build:ubsan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
test:ubsan --test_tag_filters=-no-sanitizers

build:tsan --features=tsan
build:tsan --copt=-O1
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --copt=-g
build:tsan --strip=never
build:tsan --test_env=TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1
test:tsan --test_tag_filters=-no-sanitizers

build:clang-tidy --aspects=//tools/lint:linters.bzl%clang_tidy
build:clang-tidy --output_groups=rules_lint_human
build:clang-tidy --@aspect_rules_lint//lint:fail_on_violation
