load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("@rules_python//python:defs.bzl", "py_test")

pybind_extension(
    name = "pycujpegxl",
    srcs = ["pycujpegxl.cc"],
    visibility = ["//visibility:public"],
    deps = [
        "//:cujpegxl_headers",
        "//src:cujpegxl_lib",
    ],
)

py_test(
    name = "pycujpegxl_test",
    srcs = ["pycujpegxl_test.py"],
    imports = ["."],
    deps = [":pycujpegxl"],
)
