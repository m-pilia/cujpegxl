package(default_visibility = ["//visibility:public"])

constraint_setting(
    name = "target_system",
)

constraint_value(
    name = "jetson_linux",
    constraint_setting = ":target_system",
)

config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "is_jetson",
    constraint_values = [
        ":jetson_linux",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "jetson_orin_nano",
    constraint_values = [
        ":jetson_linux",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)
