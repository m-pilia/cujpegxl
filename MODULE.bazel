module(
    name = "cujpegxl",
    version = "0.0.0",
)

# Consumer-facing dependencies: anything needed to build and link the library.
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cuda", version = "0.3.0")

# The CUDA toolkit, like the C++ toolchain, is selected by the root module:
# rules_cuda only honours toolkit tags from the root, so this hermetic redist is
# declared dev-only and a bazel_dep consumer supplies its own (see the example
# consumer). It still applies when cujpegxl itself is the root (dev/CI).
cuda = use_extension(
    "@rules_cuda//cuda:extensions.bzl",
    "toolchain",
    dev_dependency = True,
)
cuda.redist_json(
    name = "cujpegxl_cuda_redist",
    version = "12.6.3",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

# Development- and test-only dependencies. Marked dev so downstream consumers
# that depend on cujpegxl via bazel_dep neither resolve nor register them; the
# hermetic C++ toolchain in particular is the root module's responsibility.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.3.0", dev_dependency = True)
bazel_dep(name = "rules_python", version = "2.2.0", dev_dependency = True)
bazel_dep(name = "pybind11_bazel", version = "3.0.1", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.8.0", dev_dependency = True)
bazel_dep(name = "rules_foreign_cc", version = "0.14.0", dev_dependency = True)

# libjxl is fetched from pinned source and built (testonly) as the validation
# oracle. Its internal encoder symbols (ToXYB, forward DCT) are not exported by
# the system shared library, so the pinned source is compiled against the
# already-present system highway/brotli/lcms2 to reach them. Never linked into
# the runtime.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libjxl",
    build_file = "//third_party/libjxl:libjxl.BUILD",
    # libjxl vendors its own Bazel BUILD files; they would split the tree into
    # sub-packages and hide sources from the single-package glob that feeds the
    # CMake build and the internal-header library. The CMake build uses only
    # CMakeLists.txt, so the vendored BUILD files are safe to strip.
    patch_cmds = [
        "find . -mindepth 2 \\( -name BUILD -o -name 'BUILD.bazel' \\) -delete",
    ],
    sha256 = "ab38928f7f6248e2a98cc184956021acb927b16a0dee71b4d260dc040a4320ea",
    strip_prefix = "libjxl-0.11.2",
    urls = ["https://github.com/libjxl/libjxl/archive/refs/tags/v0.11.2.tar.gz"],
)

register_toolchains(
    "@rules_foreign_cc//toolchains:preinstalled_cmake_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_make_toolchain",
    dev_dependency = True,
)

PYTHON_VERSION = "3.12"

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
    dev_dependency = True,
)
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)
use_repo(python, "python_3_12")

pip = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
    dev_dependency = True,
)
pip.parse(
    hub_name = "cujpegxl_pip",
    python_version = PYTHON_VERSION,
    requirements_lock = "//third_party/python:requirements_lock.txt",
)
use_repo(pip, "cujpegxl_pip")

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    llvm_version = "19.1.0",
    # CUDA's crt headers reject libc++ on x86, so the whole toolchain uses the
    # host libstdc++ to keep host and CUDA host-side objects ABI-compatible.
    stdlib = {"linux-x86_64": "stdc++"},
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)
