module(
    name = "cujpegxl",
    version = "0.0.0",
)

# Consumer-facing dependencies: anything needed to build and link the library.
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cuda", version = "0.3.0")

# The CUDA toolkit, like the C++ toolchain, is selected by the root module:
# rules_cuda only honours toolkit tags from the root, so this hermetic redist is
# declared dev-only and a bazel_dep consumer supplies its own (see the example
# consumer). It still applies when cujpegxl itself is the root (dev/CI).
cuda = use_extension(
    "@rules_cuda//cuda:extensions.bzl",
    "toolchain",
    dev_dependency = True,
)
cuda.redist_json(
    name = "cujpegxl_cuda_redist",
    version = "12.6.3",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

# Development- and test-only dependencies. Marked dev so downstream consumers
# that depend on cujpegxl via bazel_dep neither resolve nor register them; the
# hermetic C++ toolchain in particular is the root module's responsibility.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.3.0", dev_dependency = True)
bazel_dep(name = "rules_python", version = "2.2.0", dev_dependency = True)
bazel_dep(name = "pybind11_bazel", version = "3.0.1", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.8.0", dev_dependency = True)
bazel_dep(name = "aspect_rules_lint", version = "2.7.2", dev_dependency = True)

# aspect_rules_lint pulls rules_buf -> gazelle -> rules_go@0.42.0, whose
# go_toolchain registration references the CcInfo symbol removed in our pinned
# rules_cc. Override both to versions compatible with that rules_cc.
bazel_dep(name = "rules_go", version = "0.63.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.52.2", dev_dependency = True)

# Hermetic dependencies of the pinned libjxl oracle, tracking the versions in
# libjxl's own MODULE.bazel (skcms replaces the lcms2 of the CMake build). The
# .bcr.1 revisions carry the load()-statement fixes Bazel 9 requires.
bazel_dep(name = "highway", version = "1.3.0.bcr.1", dev_dependency = True)
bazel_dep(name = "brotli", version = "1.2.0.bcr.1", dev_dependency = True)
bazel_dep(name = "skcms", version = "20250916.0.bcr.1", dev_dependency = True)

# libjxl's headers include highway with angle brackets, which does not resolve
# through Bazel's -iquote dependency include paths; expose the highway repo
# root via includes = ["."] on the hwy target.
single_version_override(
    module_name = "highway",
    patches = ["//third_party/libjxl:highway-includes.patch"],
    patch_strip = 1,
    version = "1.3.0.bcr.1",
)

# libjxl is fetched from pinned source and built (testonly) with its vendored
# Bazel BUILD files as the validation oracle, resolving @highway/@brotli/@skcms
# from this module's repo mapping. Its internal encoder symbols (ToXYB, forward
# DCT) are not exported by the system shared library, so the pinned source is
# compiled to reach them. Never linked into the runtime.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libjxl",
    # libjxl's vendored BUILD files predate Bazel 9's removal of native rules
    # (cc_library/cc_test/genrule without load()).
    patches = ["//third_party/libjxl:libjxl-bazel9.patch"],
    patch_strip = 1,
    # Export the ssimulacra2 sources under tools/ so the quality benchmark can
    # compile them; the vendored tools/BUILD keeps them package-private. The
    # root BUILD.bazel is reduced to a package declaration: its testdata
    # filegroup globs the (absent) testdata submodule and nothing needs it.
    patch_cmds = [
        "printf '\\nexports_files(glob([\"*.cc\", \"*.h\"]), visibility = [\"//visibility:public\"])\\n' >> tools/BUILD",
        "printf 'package(default_visibility = [\"//visibility:public\"])\\n' > BUILD.bazel",
    ],
    sha256 = "ab38928f7f6248e2a98cc184956021acb927b16a0dee71b4d260dc040a4320ea",
    strip_prefix = "libjxl-0.11.2",
    urls = ["https://github.com/libjxl/libjxl/archive/refs/tags/v0.11.2.tar.gz"],
)

PYTHON_VERSION = "3.12"

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
    dev_dependency = True,
)
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)
use_repo(python, "python_3_12")

pip = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
    dev_dependency = True,
)
pip.parse(
    hub_name = "cujpegxl_pip",
    python_version = PYTHON_VERSION,
    requirements_lock = "//third_party/python:requirements_lock.txt",
)
use_repo(pip, "cujpegxl_pip")

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    llvm_version = "19.1.0",
    # CUDA's crt headers reject libc++ on x86, so the whole toolchain uses the
    # host libstdc++ to keep host and CUDA host-side objects ABI-compatible.
    stdlib = {"linux-x86_64": "stdc++"},
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)
