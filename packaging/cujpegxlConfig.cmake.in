# Generated by the cujpegxl Bazel packaging target. Relocatable: the install
# prefix is derived from this file's own location so the tree can be moved.
get_filename_component(_cujpegxl_cmake_dir "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_cujpegxl_prefix "${_cujpegxl_cmake_dir}/../../.." ABSOLUTE)

if(NOT TARGET cujpegxl::cujpegxl)
    add_library(cujpegxl::cujpegxl SHARED IMPORTED)
    set_target_properties(cujpegxl::cujpegxl PROPERTIES
        IMPORTED_LOCATION "${_cujpegxl_prefix}/lib/libcujpegxl.so.@SOVERSION@"
        IMPORTED_SONAME "libcujpegxl.so.@SOVERSION@"
        INTERFACE_INCLUDE_DIRECTORIES "${_cujpegxl_prefix}/include"
    )
endif()

set(cujpegxl_VERSION "@VERSION@")
set(cujpegxl_FOUND TRUE)

unset(_cujpegxl_cmake_dir)
unset(_cujpegxl_prefix)
